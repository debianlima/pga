{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgh.local/contracts/pga-1.0/pgdmd-domain-governance.schema.json",
  "title": "PGA PGDMD accessory domain-governance contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "relation", "authority_boundary", "domain_package", "consumer_projection"],
  "properties": {
    "schema_version": {"const": "pga-pgdmd-domain-governance/1"},
    "relation": {"const": "PGDMD_ACCESSORY_OF_PGA"},
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pga_authority_ref", "creates_grants", "creates_runtime", "creates_scheduler", "creates_queue", "creates_skill_runtime"],
      "properties": {
        "pga_authority_ref": {"type": "string", "minLength": 1},
        "creates_grants": {"const": false},
        "creates_runtime": {"const": false},
        "creates_scheduler": {"const": false},
        "creates_queue": {"const": false},
        "creates_skill_runtime": {"const": false}
      }
    },
    "domain_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "domain_id", "version", "domain_model_refs", "normative_refs", "precedence", "inherits_from", "exceptions"],
      "properties": {
        "package_id": {"type": "string", "minLength": 1},
        "domain_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "domain_model_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "normative_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref", "version_ref"],
            "properties": {
              "kind": {"enum": ["policy", "standard", "process", "procedure"]},
              "ref": {"type": "string", "minLength": 1},
              "version_ref": {"type": "string", "minLength": 1}
            }
          }
        },
        "precedence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "inherits_from": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exception_ref", "authority_ref", "decision_ref", "applies_to_refs"],
            "properties": {
              "exception_ref": {"type": "string", "minLength": 1},
              "authority_ref": {"type": "string", "minLength": 1},
              "decision_ref": {"type": "string", "minLength": 1},
              "applies_to_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
            }
          }
        }
      }
    },
    "consumer_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PGA", "PGH", "PGD", "PGDMD"],
      "properties": {
        "PGA": {"const": "canonical_governance_authority"},
        "PGH": {"const": "versioned_normative_domain_reference"},
        "PGD": {"const": "policy_constraints_only_no_runtime_ownership_transfer"},
        "PGDMD": {"const": "accessory_domain_governance_reference"}
      }
    }
  }
}
